{
  "name": "morgenwerk-essensplan",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run art && vite --port 5173",
    "build": "npm run validate && npm test && npm run art && svelte-check --fail-on-warnings && tsc -p tsconfig.sw.json && vite build",
    "preview": "vite preview --port 8765 --strictPort",
    "check": "svelte-check && tsc -p tsconfig.sw.json",
    "test": "node --experimental-strip-types --no-warnings --test tests/core.test.ts",
    "validate": "node tools/validate.cjs --quiet",
    "art": "node --experimental-strip-types --no-warnings tools/render-art.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^22.20.5",
    "sharp": "^0.35.5",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^6.4.4",
    "vite-plugin-pwa": "^1.2.0"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0"
  }
}
